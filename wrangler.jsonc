{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inkspace",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-25",
  "assets": {
    // Unknown paths fall back to index.html so client-side routes work.
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; everything else is served as a static file.
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }],
  },
  // SQLite-backed Durable Objects are the kind included in the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }],
  // Per-visitor limit on the AI summary endpoint: 5 requests a minute.
  "ratelimits": [
    { "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
  ],
  "vars": {
    // Which Gemini model writes the summary. The API key is a secret, set
    // with `wrangler secret put GEMINI_API_KEY` (or in .dev.vars locally).
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
  },
}
